{
    "name": "hirale/openmage-meta-conversions",
    "type": "maho-module",
    "license": "OSL-3.0",
    "description": "Meta Conversions API integration for Maho, built on hirale/queue.",
    "keywords": [
        "maho",
        "mahoecommerce",
        "magento1",
        "meta",
        "facebook",
        "capi"
    ],
    "require": {
        "php": ">=8.3",
        "mahocommerce/maho": "^26.5",
        "hirale/queue": "^3.0 || dev-master",
        "facebook/php-business-sdk": "*",
        "jaybizzle/crawler-detect": "^1.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "config": {
        "allow-plugins": {
            "mahocommerce/maho-composer-plugin": true
        }
    },
    "autoload-dev": {
        "psr-4": {
            "HiraleMetaConversions\\Tests\\": "tests/"
        }
    },
    "extra": {
        "maho-module-dir": "app/code/community/Hirale/MetaConversions"
    },
    "scripts": {
        "test": "phpunit"
    },
    "authors": [
        {
            "name": "Hirale"
        }
    ],
    "autoload": {
        "files": [
            "lib/facebook-sdk-autoload-shim.php"
        ]
    }
}
