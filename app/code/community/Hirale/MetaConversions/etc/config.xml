<?xml version="1.0"?>
<config>
    <modules>
        <Hirale_MetaConversions>
            <version>3.0.0</version>
        </Hirale_MetaConversions>
    </modules>
    <global>
        <models>
            <metaconversions>
                <class>Hirale_MetaConversions_Model</class>
            </metaconversions>
        </models>
        <helpers>
            <metaconversions>
                <class>Hirale_MetaConversions_Helper</class>
            </metaconversions>
        </helpers>
        <!--
            Maho core queue: a CAPI upload is one outbound HTTP call per message,
            so the analytics queue is routed to the catch-all "slow" pool and never
            competes with the resident "fast" pool (order mail and friends).
            A host can retarget it from its own config.xml or local.xml.
            Ignored by hirale/queue on OpenMage, which reads <hirale_queue> below.
        -->
        <queue>
            <routing>
                <analytics>slow</analytics>
            </routing>
        </queue>
        <hirale_queue>
            <handlers>
                <Hirale_MetaConversions_Message_CapiEventMessage>metaconversions/api</Hirale_MetaConversions_Message_CapiEventMessage>
            </handlers>
            <routing>
                <Hirale_MetaConversions_Message_CapiEventMessage>analytics</Hirale_MetaConversions_Message_CapiEventMessage>
            </routing>
        </hirale_queue>
    </global>
    <default>
        <meta>
            <conversions>
                <enabled>0</enabled>
                <debug_mode>0</debug_mode>
            </conversions>
        </meta>
    </default>
    <frontend>
        <events>
            <sales_quote_item_save_after>
                <observers>
                    <metaconversions_sales_quote_item_save_after>
                        <type>singleton</type>
                        <class>metaconversions/observer</class>
                        <method>addToCart</method>
                    </metaconversions_sales_quote_item_save_after>
                </observers>
            </sales_quote_item_save_after>
            <wishlist_product_add_after>
                <observers>
                    <metaconversions_wishlist_product_add_after>
                        <type>singleton</type>
                        <class>metaconversions/observer</class>
                        <method>addToWishlist</method>
                    </metaconversions_wishlist_product_add_after>
                </observers>
            </wishlist_product_add_after>
            <customer_register_success>
                <observers>
                    <metaconversions_customer_register_success>
                        <type>singleton</type>
                        <class>metaconversions/observer</class>
                        <method>completeRegistration</method>
                    </metaconversions_customer_register_success>
                </observers>
            </customer_register_success>
            <core_app_run_after>
                <observers>
                    <metaconversions_core_app_run_after>
                        <type>singleton</type>
                        <class>metaconversions/observer</class>
                        <method>dispatchRouteEvent</method>
                    </metaconversions_core_app_run_after>
                </observers>
            </core_app_run_after>
        </events>
    </frontend>
</config>